# Cloud API
REDIS_ADDR=redis:6379
DATABASE_URL=root:root@tcp(mysql:3306)/nexusguard?charset=utf8mb4&parseTime=True&loc=Local
PORT=8080

# Edge Agent
DEVICE_ID=edge-001
CLOUD_URL=http://localhost:8080

# Vault
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

# SAP
SAP_USER=USER
SAP_PASS=PASS
SAP_HOST=host
SAP_SYSNR=00
SAP_CLIENT=100

# Jarvis Voice Interface (Whisper)
JARVIS_URL=http://nexusguard-jarvis:8081
WHISPER_MODEL=base
HF_TOKEN=your-huggingface-token

